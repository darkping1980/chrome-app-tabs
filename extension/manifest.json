{
  "manifest_version": 3,
  "name": "App Tabs",
  "version": "0.3.3",
  "description": "Show a running Windows program (e.g. VS Code) as a Chrome tab. Requires the AppTabsHost native host.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "App Tabs"
  },
  "commands": {
    "toggle-app": {
      "suggested_key": {
        "default": "Ctrl+Shift+7"
      },
      "description": "외부 프로그램 탭 ↔ 직전 웹 탭 전환",
      "global": true
    },
    "prev-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "이전 탭으로 이동",
      "global": true
    },
    "next-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "다음 탭으로 이동",
      "global": true
    }
  }
}